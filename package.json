{
  "name": "community-phages-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev --host 127.0.0.1",
    "security:check": "node scripts/validate-public-assets.mjs",
    "build": "node scripts/validate-public-assets.mjs && ASTRO_TELEMETRY_DISABLED=1 astro check && ASTRO_TELEMETRY_DISABLED=1 astro build && node scripts/fix-legacy-html-routes.mjs && node scripts/validate-public-assets.mjs --dist",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview --host 127.0.0.1",
    "astro": "ASTRO_TELEMETRY_DISABLED=1 astro"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/sitemap": "^3.2.1",
    "astro": "^7.2.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "fast-uri": "^3.1.2",
    "yaml": "^2.8.3"
  }
}
