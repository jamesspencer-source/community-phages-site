---
import PhageMark from '@components/PhageMark.astro';
import { aboutNavItems, contact, navItems, siteMeta, supportingLinks } from '@data/site';
import { mailto, withBase, withoutBase } from '@utils/urls';
import '@styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = siteMeta.description } = Astro.props;
const pageTitle = title ? `${title} | ${siteMeta.title}` : siteMeta.title;
const currentPath = Astro.url.pathname;
const activePath = withoutBase(currentPath);
const isActivePath = (href: string) => activePath.startsWith(href);
const isAboutActive = aboutNavItems.some((item) => isActivePath(item.href));
const footerLinks = [...aboutNavItems, ...navItems];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <link rel="icon" type="image/svg+xml" sizes="any" href={withBase('/favicon.svg?v=phage-atlas-2026-05')} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header" data-current-path={currentPath}>
      <a class="brand" href={withBase('/')} aria-label="Community Phages home">
        <PhageMark />
        <span>Community Phages</span>
      </a>
      <nav class="site-nav" aria-label="Main navigation">
        <details class:list={['nav-dropdown', { 'is-active': isAboutActive }]}>
          <summary class="nav-dropdown__summary" aria-current={isAboutActive ? 'page' : undefined}>
            About
          </summary>
          <div class="nav-dropdown__menu">
            {
              aboutNavItems.map((item) => (
                <a
                  href={withBase(item.href)}
                  class:list={['nav-dropdown__link', { 'is-active': isActivePath(item.href) }]}
                  aria-current={isActivePath(item.href) ? 'page' : undefined}
                >
                  {item.label}
                </a>
              ))
            }
          </div>
        </details>
        {
          navItems.map((item) => (
            <a
              href={withBase(item.href)}
              class:list={['nav-link', { 'is-active': isActivePath(item.href) }]}
              aria-current={isActivePath(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))
        }
      </nav>
      <a class="header-cta" href={mailto(contact.email, contact.subject)}>Get in touch</a>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-brand">
        <PhageMark />
        <div>
          <strong>Community Phages</strong>
          <p>A paid 8-week summer research internship for RCC students at Harvard Medical School.</p>
        </div>
      </div>
      <div class="footer-links" aria-label="Footer navigation">
        {
          footerLinks.map((item) => (
            <a href={withBase(item.href)}>{item.label}</a>
          ))
        }
      </div>
      <div class="footer-links footer-links--supporting" aria-label="Supporting navigation">
        {
          supportingLinks.map((item) => (
            <a href={withBase(item.href)}>{item.label}</a>
          ))
        }
      </div>
      <p class="footer-contact">
        Contact James Spencer about Community Phages: <a href={mailto(contact.email, contact.subject)}>Get in touch</a>.
      </p>
    </footer>
  </body>
</html>
