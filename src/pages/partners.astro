---
import PageHero from '@components/PageHero.astro';
import PartnerLogoGrid from '@components/PartnerLogoGrid.astro';
import PartnerStrip from '@components/PartnerStrip.astro';
import BaseLayout from '@layouts/BaseLayout.astro';
---

<BaseLayout
  title="Partners"
  description="HMS, RCC, sponsor, mentor, and field-site partners for Community Phages."
>
  <PageHero
    title="Partners and sponsors."
    text="Community Phages is a collaboration among Roxbury Community College, Harvard Medical School instructors, program sponsors, field sites, and scientific resource partners."
    actions={[
      { label: 'Program', href: '/program/' },
      { label: 'Students', href: '/students/', variant: 'secondary' },
    ]}
  />

  <section class="section">
    <div class="section-heading">
      <h2>Core partners.</h2>
      <p>
        HMS Microbiology, Roxbury Community College, HHMI, and New England Biolabs.
      </p>
    </div>
    <PartnerLogoGrid />
  </section>

  <section class="section">
    <div class="section-heading">
      <h2>Partner roles.</h2>
      <p>
        Student recruitment, HMS lab teaching, program funding, supplies, field access, and scientific resources.
      </p>
    </div>
    <PartnerStrip />
  </section>

  <section class="section section--band">
    <div class="section-heading">
      <h2>What partners provide.</h2>
      <p>
        Partners provide student recruitment, paid research time, lab instruction, reagents, field access, microscopy, sequencing support, and poster-session opportunities.
      </p>
    </div>
    <div class="method-sequence method-sequence--compact">
      <article class="method-sequence-card">
        <div class="method-sequence-card__marker"><span>R</span></div>
        <h3>Recruitment and access</h3>
        <p>RCC connections help the program reach students who can benefit from a first research experience.</p>
      </article>
      <article class="method-sequence-card">
        <div class="method-sequence-card__marker"><span>M</span></div>
        <h3>Mentorship</h3>
        <p>HMS instructors turn working research spaces into a supported learning environment.</p>
      </article>
      <article class="method-sequence-card">
        <div class="method-sequence-card__marker"><span>S</span></div>
        <h3>Support</h3>
        <p>Sponsors help sustain student pay, supplies, field trips, and scientific resources.</p>
      </article>
      <article class="method-sequence-card">
        <div class="method-sequence-card__marker"><span>P</span></div>
        <h3>Public records</h3>
        <p>PhagesDB records, posters, and program events document student discoveries.</p>
      </article>
    </div>
  </section>
</BaseLayout>
