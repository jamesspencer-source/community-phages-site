---
import PageHero from '@components/PageHero.astro';
import PartnerLogoGrid from '@components/PartnerLogoGrid.astro';
import PartnerStrip from '@components/PartnerStrip.astro';
import BaseLayout from '@layouts/BaseLayout.astro';
---

<BaseLayout
  title="Partners"
  description="HMS, RCC, sponsor, mentor, and field-site partners for Community Phages."
>
  <PageHero
    title="Partners and sponsors."
    text="Community Phages is run with Roxbury Community College and Harvard Medical School, with paid student research support, reagents, sequencing-related resources, and scientific mentoring from program sponsors and partners."
    actions={[
      { label: 'Program', href: '/program/' },
      { label: 'Students', href: '/students/', variant: 'secondary' },
    ]}
  />

  <section class="section">
    <div class="section-heading">
      <h2>Core partners.</h2>
      <p>
        HMS Microbiology, Roxbury Community College, HHMI, and New England Biolabs.
      </p>
    </div>
    <PartnerLogoGrid />
  </section>

  <section class="section">
    <div class="section-heading">
      <h2>Partner roles.</h2>
      <p>
        RCC coordination, HMS lab teaching, paid student research time, supplies, field access, microscopy, and sequencing-related resources.
      </p>
    </div>
    <PartnerStrip />
  </section>

  <section class="section section--band">
    <div class="section-heading">
      <h2>What partners provide.</h2>
      <p>
        Partners provide paid research time, lab instruction, reagents, field access, microscopy, sequencing-related resources, and poster-session opportunities.
      </p>
    </div>
    <div class="method-sequence method-sequence--compact">
      <article class="method-sequence-card">
        <div class="method-sequence-card__marker"><span>R</span></div>
        <h3>Recruitment and access</h3>
        <p>RCC helps identify students who are ready for a first research lab experience.</p>
      </article>
      <article class="method-sequence-card">
        <div class="method-sequence-card__marker"><span>M</span></div>
        <h3>Mentorship</h3>
        <p>HMS instructors teach in working research spaces and help students interpret results that are not known in advance.</p>
      </article>
      <article class="method-sequence-card">
        <div class="method-sequence-card__marker"><span>S</span></div>
        <h3>Funding and supplies</h3>
        <p>HHMI supports paid student research time. NEB provides program sponsorship, reagents, and sequencing-related resources.</p>
      </article>
      <article class="method-sequence-card">
        <div class="method-sequence-card__marker"><span>P</span></div>
        <h3>Public records</h3>
        <p>PhagesDB records, posters, and program events document student discoveries.</p>
      </article>
    </div>
  </section>
</BaseLayout>
