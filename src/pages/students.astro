---
import PageHero from '@components/PageHero.astro';
import GenomeTrace from '@components/GenomeTrace.astro';
import SpecimenPlate from '@components/SpecimenPlate.astro';
import { contact, studentHighlights, studentInfo } from '@data/site';
import BaseLayout from '@layouts/BaseLayout.astro';
import { mailto, withBase } from '@utils/urls';

const contactHref = mailto(contact.email, contact.subject);
---

<BaseLayout
  title="Students"
  description="Student information for Roxbury Community College students interested in the Community Phages summer research internship at Harvard Medical School."
>
  <PageHero
    motif="students"
    title="Your first research lab experience can start here."
    text="Community Phages is a paid summer research program for Roxbury Community College students. You work in an HMS lab, learn microbiology methods, look for environmental bacteriophages, and present your results."
    actions={[
      { label: 'Program schedule', href: '/program/' },
      { label: 'Get in touch', href: contactHref, variant: 'secondary' },
    ]}
  />

  <section class="section">
    <div class="section-heading">
      <h2>What the summer looks like.</h2>
      <p>
        For 2026, students are on campus May 18-July 9, Monday through Thursday, 9:00 AM-2:00 PM. The program is paid so students can spend regular summer time in the lab.
      </p>
    </div>
    <div class="lab-blocks">
      {
        studentHighlights.map((item) => (
          <article>
            <span>Student</span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section section--band">
    <div class="section-heading">
      <h2>What students work on.</h2>
      <p>
        The summer is organized around a real question: can students find bacteriophages from environmental samples that infect corynebacterial hosts? The answer is not known in advance.
      </p>
    </div>
    <div class="method-sequence method-sequence--compact">
      <article class="method-sequence-card">
        <div class="method-sequence-card__marker"><span>1</span></div>
        <h3>Learn the bench</h3>
        <p>Pipetting, sterile technique, bacterial cultures, plates, lawns, safety, labeling, and notebook habits.</p>
      </article>
      <article class="method-sequence-card">
        <div class="method-sequence-card__marker"><span>2</span></div>
        <h3>Find plaques</h3>
        <p>Environmental samples are filtered, plated, enriched, and checked for clearings that suggest phage activity. Different samples give different results.</p>
      </article>
      <article class="method-sequence-card">
        <div class="method-sequence-card__marker"><span>3</span></div>
        <h3>Characterize isolates</h3>
        <p>Students purify phages, prepare lysates, measure titers, image particles, extract DNA, and decide what each result means.</p>
      </article>
      <article class="method-sequence-card">
        <div class="method-sequence-card__marker"><span>4</span></div>
        <h3>Prepare posters and figures</h3>
        <p>Genome analysis, figures, phage names, poster practice, and final presentations turn the lab work into a clear explanation.</p>
      </article>
    </div>
    <div class="student-evidence-strip" aria-hidden="true">
      <SpecimenPlate compact tone="paper" variant={2} />
      <div class="student-evidence-strip__trace">
        <GenomeTrace />
      </div>
      <div class="student-evidence-strip__note">
        <span>Lab work</span>
        <strong>Plaque assay / DNA / BLAST</strong>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section-heading">
      <h2>Selection and timing.</h2>
      <p>
        Student selection and program dates are coordinated each year with Roxbury Community College.
      </p>
    </div>
    <div class="audience-grid">
      <article class="audience-card">
        <span>01</span>
        <div>
          <p class="small-label">Timing</p>
          <h3>Program dates</h3>
          <p>{studentInfo.status}</p>
        </div>
      </article>
      <article class="audience-card">
        <span>02</span>
        <div>
          <p class="small-label">Fit</p>
          <h3>Who the program is for</h3>
          <p>{studentInfo.eligibility}</p>
        </div>
      </article>
      <article class="audience-card">
        <span>03</span>
        <div>
          <p class="small-label">Commitment</p>
          <h3>Expected schedule</h3>
          <p>{studentInfo.schedule}</p>
        </div>
      </article>
    </div>
  </section>

  <section class="section">
    <div class="callout callout--wide">
      <div>
        <h2>Questions about student participation?</h2>
        <p>{studentInfo.note}</p>
      </div>
      <div class="action-row">
        <a class="button button--primary" href={contactHref}>Get in touch</a>
        <a class="button button--secondary" href={withBase('/resources/')}>Resources</a>
      </div>
    </div>
  </section>
</BaseLayout>
