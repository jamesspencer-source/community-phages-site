---
import PageHero from '@components/PageHero.astro';
import ProtocolIndex from '@components/ProtocolIndex.astro';
import ResourceManual from '@components/ResourceManual.astro';
import InsetFigure from '@components/InsetFigure.astro';
import BaseLayout from '@layouts/BaseLayout.astro';
---

<BaseLayout
  title="Resources"
  description="Public Community Phages protocols, bioinformatics materials, schedule references, and instructor-friendly resources."
>
  <PageHero
    title="Protocols and teaching materials."
    text="Bench protocols, bioinformatics chapters, notebook guidance, glossary, and instructor notes for Community Phages."
    actions={[
      { label: 'Program schedule', href: '/program/' },
      { label: 'Instructor information', href: '/instructors/', variant: 'secondary' },
    ]}
  />

  <section class="section">
    <div class="section-heading">
      <h2>Lab protocols.</h2>
      <p>
        The public manual includes the bench protocols, bioinformatics chapters, glossary, and notebook guidance used during the summer.
      </p>
    </div>
    <div class="inset-row inset-row--single">
      <InsetFigure
        src="/assets/community-phages-archive-banner.png"
        alt="Community Phages banner"
        label="Community Phages"
        caption="Public protocol and reference material."
        tone="graphic"
      />
    </div>
    <ProtocolIndex />
    <ResourceManual />
  </section>

  <section class="section" id="instructors">
    <div class="section-heading">
      <h2>Instructor information.</h2>
      <p>
        Instructor notes for the weekly experiments, student notebooks, genome work, and posters.
      </p>
    </div>
    <div class="lab-blocks">
      <article>
        <span>Schedule</span>
        <h3>Review the weekly plan</h3>
        <p>The 8-week outline and the usual daily structure.</p>
      </article>
      <article>
        <span>During lab</span>
        <h3>Use the protocols</h3>
        <p>Protocol pages cover pipetting, lawns, purification, titers, DNA, host range, and bioinformatics.</p>
      </article>
      <article>
        <span>Before posters</span>
        <h3>Prepare figures</h3>
        <p>Figure-making, PhagesDB context, and final presentation practice.</p>
      </article>
    </div>
  </section>
</BaseLayout>
