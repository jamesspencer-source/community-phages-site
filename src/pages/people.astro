---
import PageHero from '@components/PageHero.astro';
import PeopleDirectory from '@components/PeopleDirectory.astro';
import BaseLayout from '@layouts/BaseLayout.astro';
---

<BaseLayout
  title="People"
  description="Current Community Phages faculty sponsor, instructors, mentors, and program alumni."
>
  <PageHero
    title="Faculty, staff, instructors, and mentors."
    text="Community Phages is taught by HMS faculty, staff, graduate students, postdocs, alumni, and partner instructors who work with RCC students during the summer program."
    actions={[
      { label: 'Program timeline', href: '/program/' },
      { label: 'Resources', href: '/resources/', variant: 'secondary' },
    ]}
  />

  <section class="section">
    <div class="section-heading">
      <h2>Current team.</h2>
      <p>
        Current contributors teach bench methods, bioinformatics, microscopy, figure preparation, and final posters.
      </p>
    </div>
    <PeopleDirectory />
  </section>
</BaseLayout>
