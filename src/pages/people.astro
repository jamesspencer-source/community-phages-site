---
import PageHero from '@components/PageHero.astro';
import PeopleDirectory from '@components/PeopleDirectory.astro';
import BaseLayout from '@layouts/BaseLayout.astro';
---

<BaseLayout
  title="People"
  description="Current Community Phages faculty sponsor, program leaders, faculty partners, instructors, and mentors."
>
  <PageHero
    title="Faculty, staff, instructors, and mentors."
    text="The current Community Phages team includes Tom Bernhardt as main faculty sponsor, James and Ellie as program leads, and HMS faculty partners, graduate students, postdocs, staff, alumni, and partner instructors."
    actions={[
      { label: 'Program timeline', href: '/program/' },
      { label: 'Resources', href: '/resources/', variant: 'secondary' },
    ]}
  />

  <section class="section">
    <div class="section-heading">
      <h2>Current team.</h2>
      <p>
        Tom Bernhardt is the main faculty sponsor. James and Ellie organize the summer. Faculty partners, instructors, and mentors work with students on protocols, data analysis, and posters.
      </p>
    </div>
    <PeopleDirectory />
  </section>
</BaseLayout>
