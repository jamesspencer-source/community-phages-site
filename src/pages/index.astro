---
import AudiencePaths from '@components/AudiencePaths.astro';
import DiscoveryShowcase from '@components/DiscoveryShowcase.astro';
import FactStrip from '@components/FactStrip.astro';
import MethodRail from '@components/MethodRail.astro';
import PageHero from '@components/PageHero.astro';
import PartnerLogoGrid from '@components/PartnerLogoGrid.astro';
import { contact } from '@data/site';
import BaseLayout from '@layouts/BaseLayout.astro';
import { mailto, withBase } from '@utils/urls';

const contactHref = mailto(contact.email, contact.subject);
---

<BaseLayout>
  <PageHero
    image
    title="An 8-week phage discovery program for RCC students at HMS."
    text="Community Phages gives Roxbury Community College students paid summer research time in an HMS lab. Students collect environmental samples, test them for bacteriophages that infect corynebacteria, and work with instructors as the results come in."
    actions={[
      { label: 'For students', href: '/students/' },
      { label: 'For instructors', href: '/instructors/', variant: 'secondary' },
    ]}
  />
  <FactStrip />

  <section class="section section--institutions section--institutions-home">
    <div class="institution-block institution-block--home-feature">
      <div class="institution-block__intro">
        <h2>Affiliated institutions.</h2>
        <p>HMS Microbiology and Roxbury Community College run the program with paid student research support from HHMI and program sponsorship from New England Biolabs.</p>
      </div>
      <PartnerLogoGrid />
    </div>
  </section>

  <section class="section">
    <div class="section-heading">
      <h2>Students and instructors.</h2>
      <p>
        RCC students spend regular summer hours in an HMS lab. Instructors teach the methods, help students read results, and guide the work from plaques to posters.
      </p>
    </div>
    <AudiencePaths />
  </section>

  <section class="section section--band section--method">
    <div class="section-heading">
      <h2>8-week lab schedule.</h2>
      <p>
        The 2026 program runs May 18-July 9. Students start with sampling and bench skills, then move through plaque work, lysates, microscopy, DNA, genome analysis, and final posters.
      </p>
    </div>
    <MethodRail limit={4} />
    <div class="callout callout--wide">
      <div>
        <h3>Program schedule</h3>
        <p>The weekly lab outline for students and instructors.</p>
      </div>
      <a class="button button--primary" href={withBase('/program/')}>Program schedule</a>
    </div>
  </section>

  <section class="section">
    <div class="section-heading">
      <h2>Student phage records.</h2>
      <p>
        Student isolates can become named phages, genome assemblies, public PhagesDB records, and final posters.
      </p>
    </div>
    <DiscoveryShowcase />
  </section>

  <section class="section">
    <div class="callout callout--wide">
      <div>
        <h2>Questions about Community Phages?</h2>
        <p>Email about student participation, teaching, resources, or program partnerships.</p>
      </div>
      <div class="action-row">
        <a class="button button--primary" href={contactHref}>Get in touch</a>
        <a class="button button--secondary" href={withBase('/people/')}>People</a>
      </div>
    </div>
  </section>
</BaseLayout>
