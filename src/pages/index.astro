---
import AudiencePaths from '@components/AudiencePaths.astro';
import AtlasLabel from '@components/AtlasLabel.astro';
import DiscoveryShowcase from '@components/DiscoveryShowcase.astro';
import FactStrip from '@components/FactStrip.astro';
import GenomeTrace from '@components/GenomeTrace.astro';
import MethodRail from '@components/MethodRail.astro';
import PageHero from '@components/PageHero.astro';
import PartnerLogoGrid from '@components/PartnerLogoGrid.astro';
import SpecimenPlate from '@components/SpecimenPlate.astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import { withBase } from '@utils/urls';
---

<BaseLayout>
  <PageHero
    image
    title="An 8-week phage discovery program for RCC students at HMS."
    text="Community Phages gives Roxbury Community College students paid summer research time in an HMS lab. Students collect environmental samples, test them for bacteriophages that infect corynebacteria, and work with instructors as the results come in."
    actions={[
      { label: 'For students', href: '/students/' },
      { label: 'For instructors', href: '/instructors/', variant: 'secondary' },
    ]}
  />
  <FactStrip />

  <section class="section section--institutions section--institutions-home">
    <div class="institution-block institution-block--home-feature">
      <div class="institution-block__intro">
        <h2>Affiliated institutions.</h2>
        <p>HMS Microbiology and Roxbury Community College run the program with paid student research support from HHMI and program sponsorship from New England Biolabs.</p>
      </div>
      <PartnerLogoGrid />
    </div>
  </section>

  <section class="section">
    <div class="section-heading">
      <h2>For RCC students and HMS instructors.</h2>
      <p>
        Students learn research by doing experiments without a guaranteed answer. Instructors teach the methods, help troubleshoot, and guide the work from plaques to posters.
      </p>
    </div>
    <div class="method-spread">
      <div class="method-spread__main">
        <h3>Environmental samples, plaques, DNA, posters.</h3>
        <p>
          The summer starts with pipetting, sterile technique, and sample collection. Students plate samples, look for plaques, purify phages, prepare lysates, work with DNA, analyze genomes, and present what the evidence supports.
        </p>
        <div class="method-spread__graphics" aria-hidden="true">
          <SpecimenPlate compact tone="paper" variant={4} />
          <GenomeTrace />
        </div>
      </div>
      <AudiencePaths />
    </div>
  </section>

  <section class="section section--band section--method">
    <div class="section-heading">
      <h2>The 8-week schedule.</h2>
      <p>
        The 2026 program runs May 18-July 9. The work starts with sampling and bench skills, moves through plaques and lysates, and ends with microscopy, DNA, genome analysis, figures, and a final poster.
      </p>
    </div>
    <MethodRail limit={5} />
    <div class="callout callout--wide">
      <div>
        <h3>Program schedule</h3>
        <p>The weekly lab outline for students and instructors.</p>
      </div>
      <a class="button button--primary" href={withBase('/program/')}>Program schedule</a>
    </div>
  </section>

  <section class="section">
    <div class="section-heading">
      <h2>Student phage records.</h2>
      <p>
        Student isolates can lead to phage names, genome assemblies, PhagesDB records, and final posters.
      </p>
    </div>
    <DiscoveryShowcase />
  </section>

  <section class="section">
    <div class="section-heading">
      <h2>Faculty, instructors, and mentors.</h2>
      <p>
        HMS faculty, staff, graduate students, postdocs, alumni, RCC partners, and sponsors teach, fund, and run the summer program.
      </p>
    </div>
    <div class="team-bridge">
      <article>
        <AtlasLabel code="Faculty" title="Scientific direction" text="Corynephage biology, bacterial evolution, immunity, and host-phage experiments." />
      </article>
      <article>
        <AtlasLabel code="Program" title="Lab operations" text="Lab setup, safety, sampling, bench work, bioinformatics, and posters." />
      </article>
      <article>
        <AtlasLabel code="Mentors" title="Teaching and troubleshooting" text="Graduate students, postdocs, staff, alumni, and partner instructors work with students at the bench." />
      </article>
    </div>
    <div class="callout callout--wide">
      <div>
        <h3>Meet the current team</h3>
        <p>Faculty, staff, instructors, mentors, and alumni.</p>
      </div>
      <a class="button button--primary" href={withBase('/people/')}>People</a>
    </div>
  </section>
</BaseLayout>
