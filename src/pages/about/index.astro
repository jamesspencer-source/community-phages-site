---
import PageHero from '@components/PageHero.astro';
import PartnerLogoGrid from '@components/PartnerLogoGrid.astro';
import ProgramYearRoster from '@components/ProgramYearRoster.astro';
import { programYearRosters } from '@data/programYears';
import BaseLayout from '@layouts/BaseLayout.astro';
import { withBase } from '@utils/urls';
---

<BaseLayout
  title="About the Program"
  description="Community Phages program background and prior-year rosters."
>
  <PageHero
    title="About Community Phages."
    text="Community Phages is an 8-week paid summer research program for Roxbury Community College students at Harvard Medical School."
    actions={[
      { label: 'People', href: '/people/' },
      { label: 'History', href: '/history/', variant: 'secondary' },
    ]}
  />
  <section class="section section--institutions">
    <div class="institution-block">
      <div class="institution-block__intro">
        <h2>Affiliated institutions.</h2>
        <p>
          HMS Microbiology and Roxbury Community College run the program with paid student research support from HHMI and program sponsorship from New England Biolabs.
        </p>
      </div>
      <PartnerLogoGrid />
    </div>
  </section>
  <section class="section">
    <div class="section-heading">
      <h2>Why this program exists.</h2>
      <p>
        The program began in 2022 to give RCC students a paid first research experience in an HMS lab.
      </p>
    </div>
    <div class="lab-blocks">
      <article>
        <span>Access</span>
        <h3>Paid research time</h3>
        <p>Student pay helps students commit to the 8-week schedule without giving up summer income.</p>
      </article>
      <article>
        <span>Research</span>
        <h3>Real phage discovery</h3>
        <p>Environmental phage hunting gives students a project where the result is not known before the experiment begins.</p>
      </article>
      <article>
        <span>Mentoring</span>
        <h3>Bench instruction</h3>
        <p>HMS instructors work with students as they learn the methods, troubleshoot, analyze data, and prepare final posters.</p>
      </article>
    </div>
  </section>
  <section class="section">
    <div class="section-heading">
      <h2>Prior program years.</h2>
      <p>
        Public rosters for prior instructor teams.
      </p>
    </div>
    <div class="year-index">
      {
        programYearRosters.map((roster) => (
          <article>
            <span>{roster.year}</span>
            <h3>{roster.title}</h3>
            <p>{roster.summary}</p>
            <a href={withBase(`/about/${roster.slug}`)}>View roster</a>
          </article>
        ))
      }
    </div>
  </section>
  <section class="section section--band">
    <div class="section-heading">
      <h2>Program archive.</h2>
      <p>
        Prior-year rosters list faculty, instructors, mentors, and alumni.
      </p>
    </div>
    <ProgramYearRoster roster={programYearRosters[programYearRosters.length - 1]} />
  </section>
</BaseLayout>
