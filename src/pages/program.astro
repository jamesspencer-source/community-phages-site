---
import FactStrip from '@components/FactStrip.astro';
import PageHero from '@components/PageHero.astro';
import PartnerLogoGrid from '@components/PartnerLogoGrid.astro';
import ProgramNotebookTimeline from '@components/ProgramNotebookTimeline.astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import { withBase } from '@utils/urls';
---

<BaseLayout
  title="Program"
  description="The Community Phages summer program from lab bootcamp and field sampling to phage discovery, sequencing, bioinformatics, and final posters."
>
  <PageHero
    title="Eight weeks in the lab."
    text="The calendar changes each year, but the structure is stable: safety and pipetting, environmental sampling, plaques, purification, titers, microscopy, DNA, genome comparisons, and final posters."
    actions={[
      { label: 'Student information', href: '/students/' },
      { label: 'Instructor information', href: '/instructors/', variant: 'secondary' },
    ]}
  />
  <FactStrip />

  <section class="section section--institutions">
    <div class="institution-block">
      <div class="institution-block__intro">
        <h2>Affiliated institutions.</h2>
        <p>
          Community Phages is based in HMS Microbiology and run with Roxbury Community College, with support from HHMI and New England Biolabs.
        </p>
      </div>
      <PartnerLogoGrid />
    </div>
  </section>

  <section class="section section--band">
    <div class="section-heading">
      <h2>From field sampling to final poster.</h2>
      <p>
        Students learn core techniques, collect samples, isolate phages, analyze data, and prepare final posters.
      </p>
    </div>
    <ProgramNotebookTimeline />
  </section>

  <section class="section">
    <div class="section-heading">
      <h2>A typical lab day.</h2>
      <p>
        Students are usually on campus Monday-Thursday from 9am-2pm. Most days include setup, bench work or bioinformatics, notebook time, data review, and a decision about the next experiment.
      </p>
    </div>
    <div class="lab-blocks">
      <article>
        <span>Morning</span>
        <h3>Set up the experiment</h3>
        <p>Review the protocol, the expected result, and how the experiment relates to host bacteria or phage biology.</p>
      </article>
      <article>
        <span>Midday</span>
        <h3>Run the work</h3>
        <p>Plate samples, pick plaques, prepare lysates, run gels, image phages, compare strains, or analyze sequence data.</p>
      </article>
      <article>
        <span>Close</span>
        <h3>Record and interpret</h3>
        <p>Record observations, calculations, gels, plaques, images, and next steps while the work is still fresh.</p>
      </article>
    </div>
  </section>

  <section class="section">
    <div class="callout callout--wide">
      <div>
        <h2>Final posters.</h2>
        <p>
          Students collect samples, purify phages, document measurements, analyze DNA sequence when available, and use those data in final posters.
        </p>
      </div>
      <a class="button button--primary" href={withBase('/discoveries/')}>Discoveries</a>
    </div>
  </section>
</BaseLayout>
