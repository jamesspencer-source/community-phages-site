---
import { people } from '@data/people';
import { type ProgramYearRoster } from '@data/programYears';
import { withBase } from '@utils/urls';

interface Props {
  roster: ProgramYearRoster;
}

const { roster } = Astro.props;
const peopleByName = new Map(people.map((person) => [person.name, person]));
---

<div class="year-roster">
  {
    roster.people.map((name) => {
      const person = peopleByName.get(name);
      return (
        <article>
          <div class="year-roster__photo">
            {person?.image ? <img src={withBase(person.image)} alt={`${name} portrait`} loading="lazy" /> : <span>{person?.initials ?? name.split(' ').map((part) => part[0]).join('').slice(0, 2)}</span>}
          </div>
          <div>
            <h3>{name}</h3>
            {person && <p>{person.role} · {person.affiliation}</p>}
            {person?.bio && <p class="year-roster__bio">{person.bio}</p>}
          </div>
        </article>
      );
    })
  }
</div>
