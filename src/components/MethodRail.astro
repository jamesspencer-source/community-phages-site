---
import AtlasLabel from '@components/AtlasLabel.astro';
import MethodSignal from '@components/MethodSignal.astro';
import { programWeeks } from '@data/site';

interface Props {
  limit?: number;
}

const { limit } = Astro.props;
const steps = typeof limit === 'number' ? programWeeks.slice(0, limit) : programWeeks;
const signals = [
  { label: 'Sample', variant: 'sample' },
  { label: 'Plaques', variant: 'plaques' },
  { label: 'Purify', variant: 'purify' },
  { label: 'Image / DNA', variant: 'image' },
  { label: 'Host range', variant: 'host' },
  { label: 'Genome', variant: 'genome' },
  { label: 'Figures', variant: 'figures' },
  { label: 'Poster', variant: 'poster' },
] as const;
---

<div class="method-rail">
  <div class="method-rail__track" aria-hidden="true">
    <span></span>
  </div>
  <div class="method-rail__steps">
    {
      steps.map((week, index) => (
        <article class="method-step">
          <AtlasLabel code={`W${week.week}`} title={week.title} />
          <p>{week.short}</p>
          <MethodSignal {...signals[index % signals.length]} />
        </article>
      ))
    }
  </div>
</div>
