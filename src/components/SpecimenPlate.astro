---
interface Props {
  compact?: boolean;
  tone?: 'acid' | 'teal' | 'paper';
  variant?: number;
}

const { compact = false, tone = 'acid', variant = 1 } = Astro.props;
const normalizedVariant = ((((Number(variant) || 1) - 1) % 5) + 5) % 5 + 1;
---

<div
  class:list={[
    'specimen-plate',
    compact && 'specimen-plate--compact',
    `specimen-plate--${tone}`,
    `specimen-plate--v${normalizedVariant}`,
  ]}
  aria-hidden="true"
>
  <span></span>
  <span></span>
  <span></span>
  <span></span>
  <span></span>
  <span></span>
  <span></span>
</div>
